# Local Homebrew (recommended if something else already uses 5432):
#   bash scripts/setup-local-db.sh
#   npm run db:push
DATABASE_URL=postgresql://tcs:tcs@127.0.0.1:5433/trading_card_studio

# Or Docker (requires Docker Desktop):
#   docker compose up -d
# DATABASE_URL=postgresql://tcs:tcs@localhost:5432/trading_card_studio

# Random secret for session cookies (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
